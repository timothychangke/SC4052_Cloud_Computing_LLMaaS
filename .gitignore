# --- Dependencies ---
# Covers both the root and any subfolders (chat-ui/node_modules, etc.)
node_modules/
.venv/
venv/
env/
ENV/
bin/
lib/
develop-eggs/
dist/
build/

# --- Environment Secrets ---
# Crucial: Never push these to GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Python Specifics ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# --- IDE & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Log files ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt

# Core auxiliary files
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.toc
*.loa

# Bibliography files
*.bbl
*.blg
*.bcf
*.xml

# Indexing and Glossaries
*.glo
*.idx
*.ilg
*.ind
*.ist
*.glg
*.gls

# Lists and hyperref
*.lof
*.lot
*.out
*.run.xml

# Beamer (presentations)
*.nav
*.snm
*.vrb

# TikZ/PGF (diagrams)
*.figlist
*.makefile
*.pgf-plot.gnuplot
*.pgf-plot.table

# Output (Optional)
# Uncomment the line below if you only want to keep the source .tex files 
# and don't want the final PDF tracked in Git.
# *.pdf